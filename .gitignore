# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
.idea/

# Config file
config.toml
atrust-shou.toml
client_data.json
.shou_atrust/
shou_atrust_http.py
shou.env
# Local build outputs (SHOU)
/zju-connect
/zju-connect-armv7
/mefrpc
